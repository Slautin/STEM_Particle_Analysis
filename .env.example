# Copy to .env and edit.

# asyncroscopy MCP server (digital twin started by scripts/twin.py)
STEM_MCP_URL=http://127.0.0.1:8000/mcp

# MCP server on the real microscope (set when testing there)
# STEM_REAL_MCP_URL=http://<mcp-host>:8000/mcp

# asyncroscopy checkout used to run the digital twin
ASYNCROSCOPY_DIR=/path/to/asyncroscopy
